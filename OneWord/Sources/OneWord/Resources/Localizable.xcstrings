    "Monitora os olhos via ARKit para pausar automaticamente se você desviar o foco e vigia a taxa de piscadas para alertar sobre cansaço.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks your eyes via ARKit to pause automatically if you look away, and monitors your blink rate to warn you about fatigue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitorea tus ojos con ARKit para pausar automáticamente si desvías la mirada y vigila la frecuencia de parpadeo para avisarte del cansancio."
          }
        }
      }
    },
    "Monoespaçada": {
      "extractionState": "manual",
