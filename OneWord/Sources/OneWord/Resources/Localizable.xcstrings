          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Negro OLED Puro (ahorra batería y es cómodo en la oscuridad), Dark Slate, Sepia Vintage, Crema y Blanco Clásico."
          }
        }
      }
    },
    "ORP (Optimal Recognition Point)": {
