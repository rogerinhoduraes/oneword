    "Eleva a velocidade de leitura da média humana (180–230 WPM) para 400 a 800+ WPM com menor fadiga dos músculos oculomotores.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raises reading speed from the human average (180–230 WPM) to 400–800+ WPM with less strain on the eye muscles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva la velocidad de lectura del promedio humano (180–230 WPM) a 400–800+ WPM con menor fatiga de los músculos oculomotores."
          }
        }
      }
    },
    "Elimina a microvarredura horizontal interna dentro da palavra, permitindo reconhecimento instantâneo mesmo em termos longos ou complexos.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminates the internal horizontal micro-scanning within a word, allowing instant recognition even of long or complex terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el micro-barrido horizontal dentro de la palabra, permitiendo un reconocimiento instantáneo incluso de términos largos o complejos."
          }
        }
      }
    },
