    "Abra qualquer livro ou artigo e toque no Play. Ajuste a velocidade no velocímetro WPM em incrementos rápidos de 25 WPM.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open any book or article and tap Play. Adjust the speed on the WPM speedometer in quick 25 WPM increments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre cualquier libro o artículo y toca Play. Ajusta la velocidad en el velocímetro WPM en incrementos rápidos de 25 WPM."
          }
        }
      }
    },
    "Acabei de ler %lld palavras a %lld WPM no @OneWordApp e economizei %lld minutos com leitura rápida foveal! 🚀📖": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
