    "Ative a chave 'Eye-Tracking (Pausa por Desvio de Olhar)' nas configurações do leitor RSVP. Requer permissão da câmera frontal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the 'Eye-Tracking (Pause on Gaze Away)' switch in the RSVP reader settings. Requires front camera permission."
          }
        },
