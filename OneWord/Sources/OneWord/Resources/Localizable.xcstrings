    "A IA analisa o conteúdo lido e cria perguntas e respostas dos fatos mais relevantes para revisão espaçada.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI analyzes what you read and creates questions and answers about the most relevant facts for spaced review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA analiza el contenido leído y crea preguntas y respuestas sobre los hechos más relevantes para el repaso espaciado."
          }
        }
      }
    },
    "A URL fornecida é inválida.": {
      "extractionState": "manual",
